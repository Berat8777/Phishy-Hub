# Dev-mode only. When the packaged app runs (`app.isPackaged === true`) this
# is ignored entirely — production loads the built `web/dist` via the
# `app://` protocol handler instead (see src/main.ts).
#
# When NOT packaged (`npm run dev` / `npm start`), main.ts loads this URL so
# `web`'s own `npm run dev` Vite dev server (with hot reload) can be used
# during development. Same env-driven convention as web/.env.example's
# VITE_API_BASE_URL/VITE_SOCKET_URL — never hardcode localhost outside this
# documented default.
VITE_DEV_SERVER_URL=http://localhost:5173
