# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for Express CORS + Socket.IO CORS.
# Use "*" only for local demo convenience.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database (Postgres, see docker-compose.yml) ---
# NOTE: host port is 5433->5432 in docker-compose.yml (5432 was already taken
# on the implementer's machine by an unrelated container). Adjust if you
# remap it back to 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=phishy_hub
DB_USER=phishy_user
DB_PASSWORD=phishy_password
DB_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- MinIO / S3-compatible storage ---
# Internal endpoint: used by the API process itself to talk to MinIO
# (the API runs on the host, same as MinIO's exposed port -> localhost).
MINIO_INTERNAL_ENDPOINT=localhost
MINIO_INTERNAL_PORT=9000
# Public endpoint: baked into presigned download URLs handed to clients.
# On demo day, set this to the LAN IP of the machine running the API/MinIO.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password123
MINIO_BUCKET=phishy-hub

MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRY_SECONDS=900

# --- Logging ---
LOG_LEVEL=info
