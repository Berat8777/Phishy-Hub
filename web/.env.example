# REST API base URL (see api/.env.example -> PORT, api/CONTRACT.md §0).
# Versioned REST routes live under VITE_API_BASE_URL + /api/v1/...
VITE_API_BASE_URL=http://localhost:3000

# Socket.IO server URL (same host/port as the API — Socket.IO is mounted on
# the same HTTP server, api/src/server.ts).
VITE_SOCKET_URL=http://localhost:3000
