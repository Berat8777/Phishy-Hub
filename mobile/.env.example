# REST API base URL (see api/.env.example -> PORT, api/CONTRACT.md §0).
# Versioned REST routes live under EXPO_PUBLIC_API_BASE_URL + /api/v1/...
# Expo inlines EXPO_PUBLIC_* vars into the bundle at build time (no extra
# app.config.ts plumbing needed) — see https://docs.expo.dev/guides/environment-variables/
#
# Do NOT use "localhost" here for on-device testing (a physical phone's
# "localhost" is the phone itself, not your dev machine) — use your dev
# machine's LAN IP instead, e.g. http://192.168.1.23:3000. localhost only
# works from an Android emulator (via 10.0.2.2) or iOS simulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Socket.IO server URL (same host/port as the API — Socket.IO is mounted on
# the same HTTP server, api/src/server.ts).
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
